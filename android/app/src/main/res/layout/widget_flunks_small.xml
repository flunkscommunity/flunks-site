<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- INSERT COIN / CREDIT USED -->
    <TextView
        android:id="@+id/text_insert_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INSERT COIN"
        android:textColor="#FFD700"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1" />

    <!-- Coin Slot Panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/coin_slot_background">
        
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="10dp"
            android:background="@drawable/coin_slot_inner" />
    </FrameLayout>

    <!-- CLAIM +15 / COME BACK LATER -->
    <TextView
        android:id="@+id/text_claim_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLAIM +15"
        android:textColor="#F59E0B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/claim_button_background" />

    <!-- TOTAL GUM Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="TOTAL GUM"
        android:textColor="#9CA3AF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.08" />

    <!-- GUM Balance -->
    <TextView
        android:id="@+id/text_gum_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12,450"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

</LinearLayout>
