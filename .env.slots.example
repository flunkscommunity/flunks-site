# Slotopol Slots Server Configuration

# Slots API URL (Docker container)
NEXT_PUBLIC_SLOTS_API_URL=http://localhost:8080

# JWT Secret for slot server (match with slots-config/slot-app.yaml)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Slot Game Configuration
SLOTS_DEFAULT_CLUB_ID=1
SLOTS_DEFAULT_RTP=95.0
SLOTS_GUM_TO_CREDIT_RATIO=1

# Enable/disable slot features
NEXT_PUBLIC_SLOTS_ENABLED=true
NEXT_PUBLIC_SLOTS_MAX_BET=1000
NEXT_PUBLIC_SLOTS_MIN_BET=1
