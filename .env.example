# AI Chat Configuration
# Add your OpenAI API key here to enable real AI responses
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Example:
# OPENAI_API_KEY=sk-proj-abc123def456ghi789jkl012mno345pqr678stu901vwx234yzab567cde890fgh123ijk456lmn789opq012rst345uvw678xyz901abc234def567ghi890jkl123

# Without this key, the AI will respond with demo messages
# The system will still work but with pre-written responses instead of dynamic AI
